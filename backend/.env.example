PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

# --- Database (SQLite / libSQL) ---
# Production on Render free: a Turso cloud database (https://turso.tech)
# TURSO_DATABASE_URL=libsql://clickshare-<you>.turso.io
# TURSO_AUTH_TOKEN=
# Local: a plain SQLite file (used when TURSO_DATABASE_URL is empty)
# DB_FILE=data/clickshare.db
# Proof screenshots folder (default data/uploads)
# UPLOAD_DIR=data/uploads

# --- Business rules ---
MIN_WITHDRAWAL=100
WITHDRAWAL_FEE=0
# share of advertiser rate paid to the user (0.4 = 40%)
USER_REWARD_SHARE=0.4
# plan bonuses (Standard +15%, Pro +25%) never push the user above this share
MAX_REWARD_SHARE=0.8
# UPI ID users pay plan fees to
PAYMENT_UPI_ID=clickshare@upi

# --- Seed ---
# true = also create the demo user and sample campaigns (local development only)
SEED_DEMO=true
ADMIN_EMAIL=admin@clickshare.test
ADMIN_PASSWORD=Admin@123
DEMO_EMAIL=demo@clickshare.test
DEMO_PASSWORD=Demo@123

# --- Referrals (single level, paid from platform margin only) ---
REFERRAL_TASK_PCT=10
REFERRAL_TASK_DAYS=90
REFERRAL_MIN_TASKS=10
REFERRAL_INVITER_BONUS=2
REFERRAL_FRIEND_BONUS=1
